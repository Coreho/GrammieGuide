{
  "name": "grammieguide",
  "version": "0.1.0",
  "description": "GrammieGuide - a dementia-friendly kiosk launcher for an elderly user, with a caregiver admin panel.",
  "main": "./out/main/index.js",
  "author": "jeale",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/figtree": "^5.3.0",
    "@ghostery/adblocker-electron": "^2.18.2",
    "electron-store": "^11.0.2",
    "loudness": "^0.4.2",
    "msedge-tts": "^2.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xstate": "^5.33.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.family.grammieguide",
    "productName": "GrammieGuide",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/watchdog",
        "to": "watchdog"
      },
      {
        "from": "resources/reliability",
        "to": "reliability",
        "filter": [
          "*.cs"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/loudness/impl/windows/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "highestAvailable"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GrammieGuide",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    }
  }
}
